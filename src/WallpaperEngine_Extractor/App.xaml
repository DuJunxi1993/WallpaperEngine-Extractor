<Application x:Class="WallpaperEngine_Extractor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    ThemesDictionary 必须保留——WPF-UI 的 TextFillColorPrimaryBrush / AccentFillColorDefaultBrush
                    等前景色都来自它，删掉后深色主题下文字保持浅色默认值（黑底黑字 = 看不见）。
                    这里用无参构造，让 WPF-UI 默认跟随系统；OnStartup 再按用户设置强制覆盖到 Light/Dark。
                    不用 Theme="Dark" 硬编码避免首次启动 SwapThemeDictionary 时被旧状态污染。
                -->
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 默认字体：Windows 11 推荐 Segoe UI Variable，缺失时回退 Segoe UI -->
            <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- 默认控件样式覆盖 -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
            <Style TargetType="{x:Type Page}">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
