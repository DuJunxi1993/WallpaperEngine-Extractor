<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ==================== Light Theme Tokens ==================== -->

    <!-- Brand / Accent -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#F3F3F3</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>

    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>

    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>

    <!-- 面板背景：浅色模式用 #FEFEFE -->
    <Color x:Key="PanelBackgroundColor">#FEFEFE</Color>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#666666</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="TextTertiaryColor">#919191</Color>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

    <!-- Borders -->
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <!-- States -->
    <Color x:Key="SuccessColor">#107C10</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <Color x:Key="WarningColor">#B89500</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <Color x:Key="ErrorColor">#C42B1C</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <Color x:Key="InfoColor">#0078D4</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- ==================== Design Tokens (shared structure) ==================== -->

    <!-- Spacing -->
    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.S">8</sys:Double>
    <sys:Double x:Key="Spacing.M">12</sys:Double>
    <sys:Double x:Key="Spacing.L">16</sys:Double>
    <sys:Double x:Key="Spacing.XL">24</sys:Double>
    <sys:Double x:Key="Spacing.XXL">32</sys:Double>

    <!-- GridLength 形式的间距，用于 ColumnDefinition/RowDefinition -->
    <GridLength x:Key="ColumnSpacing.XS">4</GridLength>
    <GridLength x:Key="ColumnSpacing.S">8</GridLength>
    <GridLength x:Key="ColumnSpacing.M">12</GridLength>
    <GridLength x:Key="ColumnSpacing.L">16</GridLength>
    <GridLength x:Key="ColumnSpacing.XL">24</GridLength>

    <Thickness x:Key="CardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="PageMargin">16</Thickness>
    <Thickness x:Key="PanelGap">0,12,0,0</Thickness>
    <Thickness x:Key="PanelGap.L">0,16,0,0</Thickness>

    <CornerRadius x:Key="Radius.S">4</CornerRadius>
    <CornerRadius x:Key="Radius.M">8</CornerRadius>
    <CornerRadius x:Key="Radius.L">12</CornerRadius>

    <!-- Font sizes -->
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.BodyStrong">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Hero">36</sys:Double>

    <!-- Control sizes -->
    <sys:Double x:Key="ControlHeight.S">28</sys:Double>
    <sys:Double x:Key="ControlHeight.M">32</sys:Double>
    <sys:Double x:Key="ControlHeight.L">40</sys:Double>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="InlineButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight.S}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="72"/>
    </Style>

    <Style x:Key="CompactButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight.S}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="56"/>
    </Style>

    <!-- 窗口标题栏文本：与卡片 SectionTitle 区分层级，但同样使用 token 入口 -->
    <Style x:Key="WindowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 标题栏图标按钮：与窗口控制按钮 (Minimize/Maximize/Close) 尺寸保持一致 -->
    <Style x:Key="TitleBarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight.M}"/>
        <Setter Property="Width" Value="{DynamicResource ControlHeight.M}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>