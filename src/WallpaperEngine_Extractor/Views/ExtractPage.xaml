<Page x:Class="WallpaperEngine_Extractor.Views.ExtractPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WallpaperEngine_Extractor.ViewModels"
      xmlns:converters="clr-namespace:WallpaperEngine_Extractor.Converters"
      Background="Transparent"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch"
      Title="提取">

    <Page.DataContext>
        <vm:ExtractViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>

        <!--
            卡片通用样式：背景跟随主题。SectionTitleStyle / CaptionTextStyle / InlineButtonStyle
            等直接复用主题字典里的定义，避免重复定义造成设计 token 漂移。
        -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}"/>
            <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
        </Style>

        <!-- 主要操作按钮（取消 / 开始提取）：加高 + 使用 Body 字号 -->
        <Style x:Key="PrimaryActionStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="{DynamicResource ControlHeight.M}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding TimeText}"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1"
                        CornerRadius="{DynamicResource Radius.S}"
                        Padding="6,1"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Background="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}">
                    <TextBlock Text="{Binding Level}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding Message}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding BrowseFilesCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExtractCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelExtractCommand}"/>
    </Page.InputBindings>

    <!--
        布局：
        1. 输入卡片（Auto）
        2. 主区（*）：输出图片 (2y) + 提取日志 (1y) 在左列（1x），预览 (3y) 在右列（2x）跨两行
        3. 进度条 + 开始提取（Auto, 贴底）
    -->
    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============= Row 0: 3 个独立卡片（文件 / 输出目录 / 选项），宽度 1:1:1 ============= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="{DynamicResource ColumnSpacing.M}"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="{DynamicResource ColumnSpacing.M}"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>
            <!-- 让 3 卡片等高：父 Grid 子元素 Stretch -->
            <Grid.Resources>
                <Style x:Key="InputCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="MinHeight" Value="140"/>
                </Style>
            </Grid.Resources>

            <!-- 卡片 1：已选择的文件（与下方卡片同底色 #FEFEFE）
                 MaxHeight 限制卡片高度，避免多选几十个文件/文件夹时把整行撑高、
                 把下方"输出图片/预览/提取日志"挤出可视区。超出部分由内部
                 ScrollViewer 滚动查看。 -->
            <Border Grid.Column="0"
                    Style="{StaticResource InputCardStyle}"
                    MinHeight="92"
                    MaxHeight="230">
                <Grid>
                    <!-- 拖放靶作为 Grid 第一个 child，铺满 -->
                    <Border x:Name="FileSelectionBorder"
                            Background="Transparent"
                            AllowDrop="True"
                            DragEnter="FileSelectionBorder_DragEnter"
                            DragLeave="FileSelectionBorder_DragLeave"
                            DragOver="FileSelectionBorder_DragOver"
                            Drop="FileSelectionBorder_Drop"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Row 0: 标题 -->
                            <RowDefinition Height="*"/>      <!-- Row 1: 内容（空状态 / 已选列表） -->
                            <RowDefinition Height="Auto"/>   <!-- Row 2: 计数 + 按钮（同行） -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: 标题（只文字，按钮挪到 Row 2） -->
                        <TextBlock Grid.Row="0" Margin="0,0,0,8" Text="选择文件"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <!-- Row 1: 空状态——拖放引导 -->
                        <Grid Grid.Row="1" Visibility="{Binding HasSelectedFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowUpload24"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="拖放 PKG 文件或文件夹到此处"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,8"
                                           Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: 已选列表 -->
                        <ScrollViewer Grid.Row="1" Grid.RowSpan="1"
                                      Visibility="{Binding HasSelectedFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0"
                                                           FontSize="14"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Document24"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Symbol" Value="Folder24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayText}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Row 2: 底部一行——计数（左，撑开空间）+ 添加/清除（右）
                             计数和按钮共用一行，紧贴卡片底部边缘。 -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                            <ui:Button Content="清除"
                                       DockPanel.Dock="Right"
                                       Command="{Binding ClearFilesCommand}"
                                       Appearance="Secondary"
                                       Style="{StaticResource InlineButtonStyle}"
                                       Margin="4,0,0,0"/>
                            <ui:Button Content="添加"
                                       DockPanel.Dock="Right"
                                       Appearance="Primary"
                                       Style="{StaticResource InlineButtonStyle}"
                                       Click="ShowAddMenu_Click"
                                       ToolTip="添加文件 / 文件夹">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="添加文件..." Click="BrowseFiles_Click"/>
                                    <MenuItem Header="添加文件夹..." Click="BrowseFolder_Click"/>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding SelectedFiles.Count, StringFormat='共 {0} 项'}"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 卡片 2：输出目录 -->
            <Border Grid.Column="2" Style="{StaticResource InputCardStyle}">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="输出目录"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding OutputDirectory, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Height="{DynamicResource ControlHeight.M}"
                                 Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="1"
                                   Command="{Binding BrowseOutputCommand}"
                                   Appearance="Secondary"
                                   Height="{DynamicResource ControlHeight.M}"
                                   Width="{DynamicResource ControlHeight.M}"
                                   Padding="0"
                                   ToolTip="浏览...">
                            <ui:SymbolIcon Symbol="Folder24"/>
                        </ui:Button>
                    </Grid>
                    <ui:Button Content="打开文件夹"
                               Command="{Binding OpenOutputFolderCommand}"
                               Appearance="Secondary"
                               HorizontalAlignment="Left"
                               Style="{StaticResource InlineButtonStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 卡片 3：选项 -->
            <Border Grid.Column="4" Style="{StaticResource InputCardStyle}">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="选项" Style="{StaticResource SectionTitleStyle}"/>
                    <CheckBox Content="递归搜索子文件夹"
                              IsChecked="{Binding Settings.RecursiveSearch}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="将 TEX 纹理转换为 PNG"
                              IsChecked="{Binding Settings.ConvertTexToPng}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="提取完成后打开输出文件夹"
                              IsChecked="{Binding Settings.OpenOutputAfterExtract}"
                              Margin="0,0,0,6"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============= Row 1: 主区（左：输出图片 + 日志；右：预览跨两行） ============= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <!-- 输出图片占 2y，日志占 1y → 比例 2:1 -->
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- 左列 1x，右列 2x -->
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="{DynamicResource ColumnSpacing.M}"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 输出图片 (Col 0, Row 0)：2y 高 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="输出图片"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{Binding OrganizerStatusText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        <!-- 排序按钮：只保留图标（无文字）节省横向空间 -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding SortByTimeCommand}" Appearance="Secondary"
                                       Height="{DynamicResource ControlHeight.S}" MinWidth="0" Width="32"
                                       Padding="0" Margin="0,0,4,0" ToolTip="按时间排序">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="16"/>
                            </ui:Button>
                            <ui:Button Command="{Binding SortByNameCommand}" Appearance="Secondary"
                                       Height="{DynamicResource ControlHeight.S}" MinWidth="0" Width="32"
                                       Padding="0" Margin="0,0,4,0" ToolTip="按名称排序">
                                <ui:SymbolIcon Symbol="TextSortAscending24" FontSize="16"/>
                            </ui:Button>
                            <ui:Button Command="{Binding SortBySizeCommand}" Appearance="Secondary"
                                       Height="{DynamicResource ControlHeight.S}" MinWidth="0" Width="32"
                                       Padding="0" ToolTip="按大小排序">
                                <ui:SymbolIcon Symbol="ArrowSort24" FontSize="16"/>
                            </ui:Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasLargeFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Image24"
                                           FontSize="48"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Text="暂无大于 1MB 的图片"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"
                                       Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="提取完成后会自动扫描大图片"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Opacity="0.7"/>
                        </StackPanel>

                        <ListBox x:Name="LargeFilesList"
                                 ItemsSource="{Binding LargeFiles}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Extended"
                                 SelectionChanged="LargeFilesList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.S}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RelativePath}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="8,0,12,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ui:Button Command="{Binding SelectAllLargeFilesCommand}" Appearance="Secondary"
                                       Style="{StaticResource InlineButtonStyle}" MinWidth="64" Margin="0,0,4,0"
                                       Content="全选"/>
                            <ui:Button Command="{Binding DeselectAllLargeFilesCommand}" Appearance="Secondary"
                                       Style="{StaticResource InlineButtonStyle}" MinWidth="64"
                                       Content="取消"/>
                        </StackPanel>
                        <ui:Button DockPanel.Dock="Right"
                                   Command="{Binding SaveSelectedFilesCommand}" Appearance="Primary"
                                   Style="{StaticResource InlineButtonStyle}" MinWidth="96"
                                   Content="保存选中"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 提取日志 (Col 0, Row 1)：1y 高 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="提取日志"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <Border CornerRadius="{DynamicResource Radius.S}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Padding="6,1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LogEntries.Count, StringFormat='共 {0} 条'}"
                                           Style="{StaticResource CaptionTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="尚无日志"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="点击开始提取后会显示处理记录"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Opacity="0.7"/>
                        </StackPanel>
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding LogEntries}"
                                          ItemTemplate="{StaticResource LogEntryTemplate}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- 预览 (Col 2, RowSpan=2)：跨两行，3y 高 = 2y + 1y -->
            <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="预览" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Grid.Row="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Image24"
                                           FontSize="48"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Text="在左侧列表中选择一项以预览"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                        <!-- PreviewBorder：背景透明透出卡片色 + 紧贴边缘无 margin -->
                        <Border x:Name="PreviewBorder"
                                Background="Transparent"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Viewbox Stretch="Uniform">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============= Row 2: 进度条 + 开始提取（贴底） ============= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{DynamicResource ColumnSpacing.M}"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusText}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Progress, StringFormat='{}{0}%'}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar Grid.Row="1"
                             Value="{Binding Progress}"
                             Height="6"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                             Background="{DynamicResource ControlFillColorTransparentBrush}"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="取消"
                           Command="{Binding CancelExtractCommand}"
                           Appearance="Secondary"
                           Style="{StaticResource PrimaryActionStyle}"
                           MinWidth="80"
                           Margin="0,0,8,0"
                           ToolTip="Esc"
                           Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="开始提取"
                           Command="{Binding ExtractCommand}"
                           Appearance="Primary"
                           Style="{StaticResource PrimaryActionStyle}"
                           MinWidth="140"
                           ToolTip="Ctrl+E">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Play24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
