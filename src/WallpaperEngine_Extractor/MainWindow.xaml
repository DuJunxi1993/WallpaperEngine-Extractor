<ui:FluentWindow x:Class="WallpaperEngine_Extractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WallpaperEngine_Extractor"
        xmlns:converters="clr-namespace:WallpaperEngine_Extractor.Converters"
        Title="Wallpaper Engine Extractor"
        Width="1180"
        Height="900"
        MinWidth="1024"
        MinHeight="900"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <converters:ThemeModeToSymbolConverter x:Key="ThemeModeToSymbolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     Padding="6,0,16,0"
                     Background="Transparent"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     CanMaximize="True">
            <ui:TitleBar.Header>
                <!--
                    标题：左侧放标题文字（走 FontSize.BodyStrong=14 / SemiBold）。
                    标题栏右侧 (TrailingContent) 在 WPF-UI 模板里与 WindowButtons 是两个独立 Column，
                    所以主题切换按钮放进 TrailingContent 后与三个窗口控制按钮之间会有一列的间隙。
                -->
                <TextBlock Text="提取 PKG 文件"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Padding="0"
                           Margin="0,2,0,0"/>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <!--
                    主题切换按钮：与窗口控制按钮 (Minimize/Maximize/Close) 同尺寸 44×30。
                    注：WPF-UI TitleBar 模板里 TrailingContent 位于 ContentGrid.Column 2，
                    WindowButtons 位于 ContentGrid.Column 3；两列之间天然有 Auto 间距，
                    主题按钮只能落在 Minimize 按钮的左侧，无法与其直接相邻。要做到完全贴齐
                    窗口控制按钮，必须重写 TitleBar.ControlTemplate，把按钮放进 WindowButtons
                    sub-Grid 的最左列。
                -->
                <ui:Button x:Name="ThemeToggleButton"
                           Command="{Binding ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                           ToolTip="切换主题"
                           Height="30" Width="44"
                           Padding="0" Margin="0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Right"
                           Background="Transparent"
                           BorderBrush="Transparent"
                           WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:SymbolIcon FontSize="12"
                                   Symbol="{Binding CurrentThemeMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ThemeModeToSymbolConverter}}"/>
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Frame Grid.Row="1"
               x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource PanelBackgroundBrush}"/>
    </Grid>
</ui:FluentWindow>